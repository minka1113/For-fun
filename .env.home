# Settings for `npm run home`: run Source Lens against the self-hosted Nemotron model.
# Anything already set in your shell wins over this file, and .env is still read for the rest.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=https://llm.roostercoop.tech/v1
LOCAL_LLM_MODEL=/opt/samaritan/models/Nemotron-3-Super-120B-A12B-MLX-3.6bit
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TIMEOUT_MS=900000
