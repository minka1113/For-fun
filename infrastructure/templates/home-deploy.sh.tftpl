set -uo pipefail
TAG='{{ imageTag }}'

# Data lives on the shared (snapshotted) EBS volume. uid 1000 = "node" in the container.
mkdir -p /var/lib/source-lense/home-data /etc/home-maintenance
chown 1000:1000 /var/lib/source-lense/home-data
echo "$TAG" > /etc/home-maintenance/image_tag

# prepare: log in to ECR (tokens last 12h, so on every start) and pull the image named in image_tag.
cat > /usr/local/bin/home-maintenance-prepare <<'EOS'
#!/bin/bash
set -euo pipefail
TAG=$(cat /etc/home-maintenance/image_tag)
aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_registry}
docker pull "${ecr_url}:$TAG"
docker rm -f home-maintenance 2>/dev/null || true
EOS

cat > /usr/local/bin/home-maintenance-run <<'EOS'
#!/bin/bash
set -euo pipefail
TAG=$(cat /etc/home-maintenance/image_tag)
exec docker run --rm --init --name home-maintenance \
  -p 8788:8788 \
  -v /var/lib/source-lense/home-data:/app/data \
  -e NODE_ENV=production \
  --memory 384m \
  --cap-drop=ALL --security-opt no-new-privileges \
  --log-opt max-size=10m --log-opt max-file=3 \
  "${ecr_url}:$TAG"
EOS
chmod 755 /usr/local/bin/home-maintenance-prepare /usr/local/bin/home-maintenance-run

cat > /etc/systemd/system/home-maintenance.service <<'EOS'
[Unit]
Description=Home maintenance tracker
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
RequiresMountsFor=/var/lib/source-lense
ConditionPathExists=/etc/home-maintenance/image_tag
StartLimitIntervalSec=0

[Service]
Environment=HOME=/root
TimeoutStartSec=600
ExecStartPre=/usr/local/bin/home-maintenance-prepare
ExecStart=/usr/local/bin/home-maintenance-run
ExecStop=/usr/bin/docker stop -t 20 home-maintenance
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
EOS

systemctl daemon-reload
systemctl enable home-maintenance
systemctl restart home-maintenance || { journalctl -u home-maintenance -n 60 --no-pager; exit 1; }
for i in $(seq 1 90); do
  if out=$(curl -fsS http://localhost:8788/api/health); then echo "deployed $TAG: $out"; exit 0; fi
  sleep 2
done
echo 'health check failed'; journalctl -u home-maintenance -n 60 --no-pager; exit 1
