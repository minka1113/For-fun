# Which model does the work: "anthropic" (default) or "local" (an OpenAI-compatible server).
# `npm run home` selects the local model using .env.home.
# LLM_PROVIDER=anthropic

# Anthropic: your API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Local model (LLM_PROVIDER=local), e.g. a self-hosted Nemotron behind an OpenAI-style API.
# LOCAL_LLM_BASE_URL=https://llm.roostercoop.tech/v1
# LOCAL_LLM_MODEL=/opt/samaritan/models/Nemotron-3-Super-120B-A12B-MLX-3.6bit
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_TIMEOUT_MS=900000

# Optional: server port (defaults to 8787)
# PORT=8787
